@node Manual
@subsection Manual

Clone the repository and add it to your load path:

@lisp
(add-to-list 'load-path "/path/to/goldendict-ng")
(require 'goldendict-ng)
@end lisp

@node use-package with vc (Emacs 30+)
@subsection use-package with vc (Emacs 30+)

@lisp
(use-package goldendict-ng
  :vc (:url "https://github.com/benthamite/goldendict-ng"
       :rev :newest))
@end lisp

